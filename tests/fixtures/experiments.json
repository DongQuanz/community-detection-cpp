      "algorithms": ["girvan_newman", "spectral", "louvain", "label_propagation"],
      "algorithm_seeds": {
        "girvan_newman": [42],
        "spectral": [11, 37],
        "louvain": [11, 37],
        "label_propagation": [11, 37]
      },
      "dropout": [
        {"rate": 0.0, "seeds": [0]},
        {"rate": 0.1, "seeds": [19]}
      ]
    }
  ]
