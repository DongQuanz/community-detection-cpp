{
  "manifest": "build-test-data/manifest.json",
  "output_dir": "build-test-results",
  "resource_guards": {
    "girvan_newman_max_n": 100,
    "girvan_newman_max_m": 100,
    "spectral_max_edge_visits": 1000000,
    "spectral_max_orthogonalization_ops": 1000000
  },
  "algorithm_options": {
    "spectral": {
      "laplacian": "normalized",
